{
  "name": "weave",
  "private": true,
  "version": "0.8.58",
  "description": "Enhance knowledge learning and memory consolidation with memory decks and practice quiz decks",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-watch.cjs",
    "dev:fresh": "npm run clean:cache && npm run dev",
    "predev:mobile": "node scripts/kill-vite.cjs --target=mobile",
    "predev:mobile:watch": "node scripts/kill-vite.cjs --target=mobile",
    "kill:vite": "node scripts/kill-vite.cjs",
    "kill:vite:desktop": "node scripts/kill-vite.cjs --target=desktop",
    "kill:vite:mobile": "node scripts/kill-vite.cjs --target=mobile",
    "prebuild": "node scripts/kill-vite.cjs",
    "build": "npm run check:encoding && node --max-old-space-size=4096 node_modules/vite/bin/vite.js build --mode production",
    "build:release": "npm run check:encoding && node --max-old-space-size=4096 node_modules/vite/bin/vite.js build --mode production",
    "build:mobile": "npm run build && node scripts/deploy-mobile.cjs",
    "deploy:mobile": "scripts\\sync-to-mobile-adb.bat",
    "dev:mobile": "node scripts/dev-mobile.cjs",
    "dev:mobile:watch": "node scripts/watch-mobile.cjs",
    "copy:mobile": "node scripts/copy-to-mobile.cjs",
    "copy:mobile:watch": "node scripts/copy-to-mobile.cjs --watch",
    "postbuild": "node scripts/copy-manifest.cjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "check": "npm run check:types",
    "check:types": "npm run check:encoding && node scripts/run-typecheck.cjs",
    "check:types:baseline": "node scripts/typecheck-baseline.cjs --write-baseline",
    "check:types:gate": "node scripts/typecheck-baseline.cjs",
    "check:types:report": "node scripts/run-typecheck.cjs --write-report && node scripts/analyze-typecheck-output.cjs typecheck-raw.txt",
    "check:types:analyze": "node scripts/analyze-typecheck-output.cjs typecheck-raw.txt",
    "check:encoding": "node scripts/check-mojibake.cjs",
    "check:encoding:baseline": "node scripts/check-mojibake.cjs --write-baseline",
    "format": "biome format --write ./src",
    "lint": "biome lint --apply-unsafe ./src",
    "lint:check": "biome check ./src",
    "lint:ci": "npm run lint:check",
    "lint:obsidian": "eslint -c eslint.obsidian.config.mjs src --max-warnings 9999",
    "lint:obsidian:community": "eslint -c eslint.community.config.mjs src --max-warnings 99999",
    "lint:obsidian:community:errors": "node scripts/lint-obsidian-community-errors.cjs",
    "lint:obsidian:disallowed-disables": "node scripts/check-disallowed-disables.cjs",
    "lint:obsidian:warnings": "node scripts/list-community-warnings.cjs",
    "lint:obsidian:score": "node scripts/lint-obsidian-score.cjs",
    "lint:obsidian:strict": "node scripts/lint-obsidian-strict.cjs",
    "codemod:prefer-active-document": "node scripts/codemods/prefer-active-document.cjs",
    "codemod:timer-handle": "node scripts/codemods/normalize-timer-handle.cjs && node scripts/codemods/fix-svelte-timer-imports.cjs",
    "audit:obsidian-release": "node scripts/audit-obsidian-release.cjs",
    "check:dynamic-script": "node scripts/check-dynamic-script.cjs",
    "sync:public-versions": "node scripts/sync-public-versions.cjs",
    "sync:obsidian-version": "node scripts/sync-obsidian-community-version.cjs",
    "publish:local-release": "node scripts/publish-local-github-release.cjs",
    "lint:promises": "eslint -c eslint.config.mjs src/**/*.ts --max-warnings 9999",
    "lint:svelte5": "node scripts/check-svelte5-compliance.js",
    "audit:todos": "node scripts/audit-todos.cjs",
    "status:hygiene": "node scripts/audit-worktree-hygiene.cjs",
    "audit:test-health": "node scripts/audit-test-health.cjs",
    "audit:i18n": "node scripts/audit-i18n.mjs",
    "clean": "rimraf dist node_modules/.vite",
    "clean:cache": "node scripts/clean-cache.cjs",
    "clean:console": "node scripts/clean-console-logs.js",
    "clean:console:dry": "node scripts/clean-console-logs.js --dry-run",
    "reinstall": "npm run clean && npm install"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "anki",
    "spaced-repetition",
    "fsrs",
    "learning",
    "flashcards",
    "svelte",
    "svelte5",
    "typescript"
  ],
  "author": "Weave Team",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhuzhige123/obsidian---Weave.git"
  },
  "bugs": {
    "url": "https://github.com/zhuzhige123/obsidian---Weave/issues"
  },
  "homepage": "https://github.com/zhuzhige123/obsidian---Weave#readme",
  "devDependencies": {
    "@biomejs/biome": "1.3.3",
    "@codemirror/autocomplete": "6.18.6",
    "@codemirror/commands": "6.8.1",
    "@codemirror/lang-markdown": "6.3.4",
    "@codemirror/language": "6.11.2",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.1",
    "@eslint/js": "9.30.1",
    "@eslint/json": "0.14.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/svelte": "5.2.8",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^20.8.10",
    "@types/sql.js": "1.4.9",
    "@typescript-eslint/eslint-plugin": "8.56.1",
    "@typescript-eslint/parser": "8.56.1",
    "@unocss/extractor-svelte": "^0.57.2",
    "bun-types": "latest",
    "eslint": "9.39.1",
    "eslint-plugin-obsidianmd": "0.3.0",
    "fast-check": "4.5.3",
    "jsdom": "26.1.0",
    "obsidian": "^1.4.11",
    "svelte": "5.55.10",
    "svelte-check": "^4.0.0",
    "tslib": "^2.6.2",
    "typescript": "^5.2.2",
    "typescript-eslint": "8.57.2",
    "unocss": "^0.57.2",
    "vite": "^5.0.0",
    "vite-plugin-commonjs": "0.10.4",
    "vite-plugin-static-copy": "^3.1.1",
    "vitest": "^1.3.1"
  },
  "dependencies": {
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.9",
    "@codemirror/lang-javascript": "6.2.4",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-sql": "6.9.1",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/search": "6.5.11",
    "@codemirror/theme-one-dark": "6.1.3",
    "@floating-ui/dom": "1.7.4",
    "@lezer/highlight": "1.2.3",
    "@tanstack/svelte-virtual": "3.13.12",
    "@tanstack/table-core": "8.21.3",
    "@tanstack/virtual-core": "3.13.13",
    "echarts": "6.1.0",
    "jszip": "3.10.1",
    "monkey-around": "3.0.0",
    "pako": "^2.1.0",
    "sql.js": "1.13.0",
    "ts-fsrs": "5.4.0"
  },
  "overrides": {
    "svelte": "5.55.10"
  }
}
