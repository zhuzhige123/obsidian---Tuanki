# Weave 开发环境配置示例
# 复制此文件为 .env 并根据您的环境修改配置

# Obsidian 桌面端热重载路径（npm run dev 必需）
# 指向测试库的 .obsidian 目录（不是 plugins/weave 本身）
# 构建会先写入 .desktop-hot-reload，再同步到：
#   <库根>/.obsidian/plugins/weave/
# 本机桌面测试库示例：
# OBSIDIAN_VAULT_PATH="C:/Users/lihua/Desktop/obsidian weave插件系列开发/plugin testing library/.obsidian"
# 手机 ADB 推送使用 .mobile-config.json，与此项无关
OBSIDIAN_VAULT_PATH=""

# 开发模式配置
NODE_ENV=development

# 构建配置
VITE_BUILD_TARGET=development
VITE_SOURCEMAP=true
VITE_MINIFY=false

# 热重载配置
VITE_HMR=true
VITE_WATCH_POLLING=true
VITE_WATCH_INTERVAL=300

# 调试配置
DEBUG_MODE=true
VERBOSE_LOGGING=false
PERFORMANCE_MONITORING=false

# 插件配置
PLUGIN_ID=weave
PLUGIN_NAME="Weave"
PLUGIN_VERSION=0.7.8

# 测试配置
VITEST_ENVIRONMENT=jsdom
VITEST_COVERAGE=true
